# Public Getform endpoint for the contact form (client-side POST).
# Falls back to the documented default in src/lib/content/site.ts when unset.
NEXT_PUBLIC_GETFORM_ENDPOINT=https://getform.io/f/f07994de-98f2-4f00-91b1-d2aec22d8ee8

# Liquid-glass hero canvas (Phase 1b). Default on when unset.
# Set to false to force the static CSS mesh fallback.
NEXT_PUBLIC_ENABLE_LIQUID_GLASS=true
